    {
      "id": "claim_a47de5450b76436aaee583959a587209",
      "statement": "The three generators in `lib/utils/` (branch-name-generator.ts, commit-message-generator.ts, title-generator.ts) share a common skeleton: AI SDK 5 `generateText` with `model: 'openai/gpt-5-nano'` and `temperature: 0.3`, a `process.env.AI_GATEWAY_API_KEY` precondition that throws when absent, a `result.text.trim().replace(/^[\"']|[\"']$/g, '')` cleanup, a length-or-regex validation step, and a synchronous fallback function that produces a usable string with no AI dependency.",
      "evidence": [
        {
          "resource": "repo://lib/utils/branch-name-generator.ts#L10-L71",
          "version": "repo-lines-v1:sha256:34080810031fd89ff87e2f657bb99b607a31726b567873aacd739dd1f41a43ba:"
