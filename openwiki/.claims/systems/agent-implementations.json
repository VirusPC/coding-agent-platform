          "version": "repo-lines-v1:sha256:eee707bd1299d661815648e42b6db4f8b45bc5b188a8e14f7b4a933b9eb33e17:"
        },
        {
          "resource": "repo://lib/sandbox/agents/opencode.ts#L380-L386",
          "version": "repo-lines-v1:sha256:fcc4356032ca0f1abef8f8c3e6013df0b63835de74bcbb47a9794fbd4a7ab83e:"
        }
      ]
    },
    {
      "id": "claim_c7763b1807504949a0b18a447c12b94f",
      "statement": "Every wrapper redacts secrets before logging: each command line and each stdout/stderr line passed to the logger goes through `redactSensitiveInfo` (`lib/utils/logging.ts`), which masks API keys, GitHub tokens, and `SANDBOX_VERCEL_*` values. The wrappers also pre-compute a redacted command string before calling `logger.command(...)` so persisted logs never carry an API key in the clear.",
      "evidence": [
        {
          "resource": "repo://lib/sandbox/agents/claude.ts#L15-L60",
          "version": "repo-lines-v1:sha256:96b93c7faccd00554ec27f53a890f801b46d5bfafd8e3e133ac3ec06459096ed:"
        },
