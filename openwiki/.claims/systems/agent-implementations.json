    {
      "id": "claim_bcb8119a172d4414827f1624eee54b31",
      "statement": "Per-agent auth requirements, enforced by `validateEnvironmentVariables` in `lib/sandbox/config.ts` and re-checked inside each wrapper: Claude and Codex require `AI_GATEWAY_API_KEY`; Cursor requires `CURSOR_API_KEY`; Gemini requires `GEMINI_API_KEY` (with Vertex AI and OAuth alternatives the wrapper also accepts); OpenCode requires `OPENAI_API_KEY` OR `ANTHROPIC_API_KEY`; Copilot requires `GH_TOKEN` or `GITHUB_TOKEN`.",
      "evidence": [
        {
          "resource": "repo://lib/sandbox/agents/copilot.ts#L93-L100",
          "version": "repo-lines-v1:sha256:b2103f74781134748964cff515bb71c02b86fdc075693271eaab641fe8abd178:"
        },
