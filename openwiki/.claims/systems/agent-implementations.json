    {
      "id": "claim_075f96ae74594786a0c33c1ff8707bfe",
      "statement": "Cursor installs the CLI into `~/.local/bin/cursor-agent` via `curl https://cursor.com/install -fsS | bash -s -- --verbose`, runs post-install reachability checks (`ls -la ~/.local/bin/`, `which cursor-agent` with extended `PATH`), and on success invokes the binary by its absolute path (`/home/vercel-sandbox/.local/bin/cursor-agent`) rather than via `sh -c`. `CURSOR_API_KEY` is the only credential this wrapper accepts.",
      "evidence": [
        {
          "resource": "repo://lib/sandbox/agents/cursor.ts#L461-L472",
          "version": "repo-lines-v1:sha256:1b23895d5a56996ef5f79f56883d37f88eb4060f3aeb99569d2a7e8e480d4f34:"
        },
        {
