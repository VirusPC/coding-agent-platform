          "version": "repo-lines-v1:sha256:d376e4313c87e01626ad228041d106ea148d10124ac05da85f18064cea372133:"
        }
      ]
    },
    {
      "id": "claim_90e5b11e8fc04abd98f2a365ac9673c4",
      "statement": "The six wrappers each write their MCP config to a different well-known file: Claude uses the CLI's internal store via `claude mcp add`, Codex writes `~/.codex/config.toml` (TOML), Copilot writes `~/.copilot/mcp-config.json` and passes it via `--additional-mcp-config @PATH`, Cursor writes `~/.cursor/mcp.json`, Gemini writes `~/.gemini/settings.json` (with the unique remote key `httpUrl`), and OpenCode writes `~/.opencode/config.json` (with a typed `type: 'local' | 'remote'` discriminator and bundled `command: string[]`).",
      "evidence": [
        {
          "resource": "repo://lib/sandbox/agents/claude.ts#L99-L148",
          "version": "repo-lines-v1:sha256:03b914cb944786d552d99f2e96834dee3736831bb1bbf2388d2839429dfd2853:"
