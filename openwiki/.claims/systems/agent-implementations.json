    {
      "id": "claim_a8599983d248455db85f95bc68c5d413",
      "statement": "Claude installs via `curl -fsSL https://claude.ai/install.sh | bash` and writes `$HOME/.config/claude/config.json` containing `api_key`, `api_base_url` (set to `https://ai-gateway.vercel.sh`), and `default_model`. The wrapper also prefixes every shell invocation with `ANTHROPIC_API_KEY` and `ANTHROPIC_BASE_URL=https://ai-gateway.vercel.sh`, so the Claude CLI sees the gateway through two channels.",
      "evidence": [
        {
          "resource": "repo://lib/sandbox/agents/claude.ts#L151-L176",
          "version": "repo-lines-v1:sha256:86a91d0c469719be35187121fed964cc6532a5025c654a998fff5a94363701d4:"
        },
        {
          "resource": "repo://lib/sandbox/agents/claude.ts#L80-L80",
          "version": "repo-lines-v1:sha256:9a8f9ab24362982defc5ce233b3b95985c41eaed1b6b142f933a923bdb0a6007:"
        }
      ]
