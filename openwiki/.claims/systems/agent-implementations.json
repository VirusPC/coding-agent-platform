        }
      ]
    },
    {
      "id": "claim_3d5e6c974bb14b3fbab407b2762fa73d",
      "statement": "Gemini implements a two-step retry chain when the first invocation fails with a \"Tool not found in registry\" error: the wrapper first retries with `--approval-mode auto_edit -o text`, then with the minimal flag set. Codex and OpenCode recover their `sessionId` for follow-up runs by matching the regex `(?:session[_\\s-]?id|Session)[:\\s]+([a-f0-9-]+)` against the CLI's output text.",
      "evidence": [
        {
          "resource": "repo://lib/sandbox/agents/codex.ts#L336-L343",
          "version": "repo-lines-v1:sha256:77d408e5767f7730671cbaad6471ed6cbda51fac651f39cc25fea36d60ef7e21:"
        },
        {
