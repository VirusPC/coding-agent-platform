        },
        {
          "resource": "repo://lib/sandbox/agents/opencode.ts#L60-L310",
          "version": "repo-lines-v1:sha256:d190701092f5a19a2b573ca5add033b93cc55246fdc04cf56dae7af678bc1d67:"
        }
      ]
    },
    {
      "id": "claim_e569b1bf871547f784cbcc4cfcf4e3b1",
      "statement": "Decryption failures inside `getUserApiKeys`/`getUserApiKey` (e.g. `ENCRYPTION_KEY` rotated and old rows are unreadable) are caught, logged, and silently degraded to the env-initialized fallback — there is no retry, no surface error to the caller, and no signal in the response shape; a rotation of `ENCRYPTION_KEY` therefore requires every user to re-save their API key for the user-key path to become reachable again.",
      "evidence": [
        {
          "resource": "repo://lib/api-keys/user-keys.ts#L37-L66",
          "version": "repo-lines-v1:sha256:43cbd751dbec977438fb1c72dac86b9fa2a822f460b1807e1bbbf6ad257c3e6a:"
        },
        {
