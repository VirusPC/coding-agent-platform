          "version": "repo-lines-v1:sha256:a5b5fa63d450e37da4fe976cb06a836b30a2d8ccd5bf119558fdd7b3972d99aa:"
        }
      ]
    },
    {
      "id": "claim_256cef09ef86452691b981cbf4fe1502",
      "statement": "`validateEnvironmentVariables(selectedAgent, githubToken, apiKeys)` in `lib/sandbox/config.ts` accepts either a value in the `apiKeys` argument or the corresponding `process.env.*` variable as satisfying the per-agent key requirement, which is what allows a user with their own `AI_GATEWAY_API_KEY` row to pass the Claude/Codex gate on a deploy without `AI_GATEWAY_API_KEY` set globally — the gate runs before sandbox creation and accumulates errors into a single combined message.",
      "evidence": [
