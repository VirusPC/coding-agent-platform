    {
      "id": "claim_cecec162362543988577dc3687a873f0",
      "statement": "When agentType is 'copilot', the dispatcher dynamically imports getUserGitHubToken from @/lib/github/user-token and, if it returns a value, assigns it to both process.env.GH_TOKEN and process.env.GITHUB_TOKEN; the restore block writes both back.",
      "evidence": [
