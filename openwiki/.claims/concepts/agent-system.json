    {
      "id": "claim_4c2816b1d51b45f5af53ef3f3dd2e5b9",
      "statement": "Each per-CLI wrapper translates the shared Connector shape into its own CLI dialect: claude uses `claude mcp add` with --env flags for local and --transport http with --header flags for remote; codex writes [mcp_servers.<name>] blocks (and prepends experimental_use_rmcp_client = true if any remote) into ~/.codex/config.toml; copilot writes a JSON file at ~/.copilot/mcp-config.json and passes it via --additional-mcp-config @<path>; cursor writes ~/.cursor/mcp.json; gemini writes ~/.gemini/settings.json with httpUrl for remote; opencode writes ~/.opencode/config.json with typed 'local'/'remote' discriminators and command as string[].",
      "evidence": [
        {
          "resource": "repo://lib/sandbox/agents/claude.ts#L99-L148",
          "version": "repo-lines-v1:sha256:03b914cb944786d552d99f2e96834dee3736831bb1bbf2388d2839429dfd2853:"
