    {
      "id": "claim_ba478a5c33a044118f83cb3dc70544ba",
      "statement": "The dispatcher does not decrypt MCP secrets itself; decryption is performed by the task worker in app/api/tasks/route.ts and app/api/tasks/[taskId]/continue/route.ts, which filters connectors by userId and status='connected' and calls lib/crypto.ts decrypt on each row's oauthClientSecret and env before passing the result as mcpServers.",
      "evidence": [
        {
          "resource": "repo://app/api/tasks/%5BtaskId%5D/continue/route.ts#L288-L315",
          "version": "repo-lines-v1:sha256:48933b9fd758c8d8e3f907f743718bf7a2179e6ec5f1375137fe80e5b911c190:"
