  "claims": [
    {
      "id": "claim_287240dbbb8d4b3a907959ddb613da78",
      "statement": "executeAgentInSandbox in lib/sandbox/agents/index.ts is the single dispatcher that the task worker uses to run an agent; it is the only place that knows about the full set of supported CLIs and is called by POST /api/tasks and PATCH /api/tasks/:taskId/continue with the already-decrypted user MCP connectors.",
      "evidence": [
        {
          "resource": "repo://app/api/tasks/%5BtaskId%5D/continue/route.ts#L324-L337",
          "version": "repo-lines-v1:sha256:9fff3399ca93f121d7d12da1292ef835a990653c387e0240f753f0aa51967623:"
        },
        {
          "resource": "repo://app/api/tasks/route.ts#L590-L600",
          "version": "repo-lines-v1:sha256:d56a44da76b399e103df486b88778a0894219cbcf39babf680f5ef2a74b8e0bb:"
        },
        {
          "resource": "repo://lib/sandbox/agents/index.ts#L18-L37",
          "version": "repo-lines-v1:sha256:50dcd94960af5b33673f93f9d22c6845559089ed26794efe7298a64b293f8f6c:"
        }
      ]
    },
    {
      "id": "claim_3e78e2f57db04d4abe916e4583c21dfd",
      "statement": "The AgentType union declared in lib/sandbox/agents/index.ts is 'claude' | 'codex' | 'copilot' | 'cursor' | 'gemini' | 'opencode', and the dispatcher routes to a per-CLI wrapper through a single switch with a default branch that returns a structured failure for an unrecognized value.",
      "evidence": [
        {
          "resource": "repo://lib/sandbox/agents/index.ts#L12-L12",
          "version": "repo-lines-v1:sha256:0605ecf44146ba91a68b0b250367eae107baf91f65f746d4f0186bd5bcf89a0a:"
