    {
      "id": "claim_7ab09979789e4d0a8454460a24673c28",
      "statement": "The connectors table in lib/db/schema.ts stores MCP server definitions with type in {'local','remote'}, optional baseUrl and oauthClientId, an oauthClientSecret column, an optional command string for local STDIO servers, and an env column holding an encrypted JSON object of key-value pairs; the dispatcher's Connector type is the inferred select type of that table.",
      "evidence": [
        {
          "resource": "repo://lib/db/schema.ts#L184-L211",
          "version": "repo-lines-v1:sha256:d87f9587d02bf096f6a58b06441e9682a13bcf384d6f87a7a5f3e7b6cfb83348:"
