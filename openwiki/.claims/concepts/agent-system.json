        }
      ]
    },
    {
      "id": "claim_a42a02efa26b4677aa15e81f65d2bd7a",
      "statement": "The dispatcher calls the optional onCancellationCheck callback before any per-CLI work; if it resolves to true the dispatcher logs 'Task was cancelled before agent execution' and returns a failed AgentExecutionResult with cliName set to agentType and changesDetected false.",
      "evidence": [
        {
          "resource": "repo://lib/sandbox/agents/index.ts#L38-L47",
          "version": "repo-lines-v1:sha256:fd7e82fffab9c18959106a9645cc44c65869c97c2877a587762200fa3ca8f652:"
        }
      ]
    },
    {
      "id": "claim_2653da0c1783458097b93eba8506b42a",
      "statement": "The dispatcher implements a temp-env-var pattern: it snapshots OPENAI_API_KEY, GEMINI_API_KEY, CURSOR_API_KEY, ANTHROPIC_API_KEY, AI_GATEWAY_API_KEY, GH_TOKEN, and GITHUB_TOKEN into originalEnv before any override, applies user-supplied apiKeys (and the GitHub token for the Copilot agent to both GH_TOKEN and GITHUB_TOKEN), then restores all seven in a finally block regardless of which switch branch ran.",
      "evidence": [
        {
          "resource": "repo://lib/sandbox/agents/index.ts#L149-L158",
          "version": "repo-lines-v1:sha256:d3c69f6a9bb5cd8ad4a923b4a9911624a2ded3cc79c662918ff5a384d13cac8b:"
