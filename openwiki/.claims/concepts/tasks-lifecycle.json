  "claims": [
    {
      "id": "claim_d522a4d8ba7648ff8b3d1176fc65e708",
      "statement": "The `tasks` table is the central unit of work: one row represents one agent run, with a foreign key to `users.id` using `onDelete: cascade`; the row is the only durable handle on a long-running piece of work because the HTTP request that creates it returns within milliseconds while the worker may run for many minutes.",
      "evidence": [
        {
          "resource": "repo://lib/db/schema.ts#L76-L114",
          "version": "repo-lines-v1:sha256:f6502d8761128d54c5f16af37178feb49bab743ecf51abceb61e7fee3a9c383e:"
        },
        {
          "resource": "repo://lib/db/schema.ts#L79-L80",
          "version": "repo-lines-v1:sha256:937d81ff3b270dece9cc89ada73eb3898daef90c8a7599b269a53579273f12d3:"
        }
      ]
    },
    {
      "id": "claim_bbd566ca33ec4a7e825f8fc92a7fd786",
      "statement": "`tasks.status` is constrained to a five-value PostgreSQL enum (`pending | processing | completed | error | stopped`); `TaskLogger.updateStatus` only accepts the first four values, so the only writer of `status='stopped'` is `PATCH /api/tasks/:taskId` with `action: 'stop'`, while the worker detects `status === 'stopped'` at its `isTaskStopped` checkpoints and exits without mutating state.",
      "evidence": [
        {
          "resource": "repo://app/api/tasks/%5BtaskId%5D/route.ts#L62-L110",
          "version": "repo-lines-v1:sha256:9f1ed284289220e1fbdc20d1540a6388da77ea46e4f13d714ee900155ec9fd21:"
