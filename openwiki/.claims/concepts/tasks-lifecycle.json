    {
      "id": "claim_a4b7b90ddd67488cb5686135a84b04ba",
      "statement": "The daily rate limit is a single combined counter: `count = tasksToday + userMessagesToday` where `tasksToday` is rows in `tasks` with `createdAt >= startOfTodayUtc()` and `isNull(deletedAt)`, and `userMessagesToday` is rows in `taskMessages` with `role='user'` joined to a non-deleted `tasks` row in the same UTC window; the cap resolves through per-user `settings` row → `MAX_MESSAGES_PER_DAY` env → constant default `5`, and the window is the UTC day so `resetAt` is the next UTC midnight.",
      "evidence": [
        {
          "resource": "repo://lib/constants.ts#L2-L2",
          "version": "repo-lines-v1:sha256:015b27f395017943a1d42edfa468fe0cd0fd2ce8b1186de745d759be7b4edd2a:"
