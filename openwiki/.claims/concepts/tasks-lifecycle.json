    {
      "id": "claim_b5a95b001b6140eea601f2a28da0fd8a",
      "statement": "`PATCH /api/tasks/:taskId` with `action: 'stop'` is the only status mutation gated by current state: it rejects with `400 'Task can only be stopped when it is in progress'` unless `existingTask.status === 'processing'`, then writes `status='stopped'`, `error='Task was stopped by user'`, and `completedAt=now` and calls `killSandbox(taskId)` from the in-memory registry.",
      "evidence": [
