    {
      "id": "claim_d20f9c6e60484fde82db89f9646414a9",
      "statement": "`tasks.completedAt` is written in exactly three places — `PATCH /api/tasks/:taskId` with `action: 'stop'` (user-initiated stop), `POST /api/tasks/:taskId/merge-pr` (PR merged), and cleared back to `NULL` by `POST /api/tasks/:taskId/continue`; the worker's own success path (`logger.updateStatus('completed')`) does NOT set `completedAt`, and an inline comment at `task-logger.ts:105` is explicit that \"completedAt is only set when PR is merged, not when status changes to 'completed'\", so `status='completed' && completedAt IS NULL` is the normal state for a task that pushed its branch but whose PR has not been merged.",
      "evidence": [
        {
          "resource": "repo://app/api/tasks/%5BtaskId%5D/continue/route.ts#L77-L85",
          "version": "repo-lines-v1:sha256:b7a88dcb0b6fecd4d62326693f3f0a3d1e89852d0ceb9698ffe3a44187b9347a:"
