        }
      ]
    },
    {
      "id": "claim_c6cb3bfc6b314a8aa5c8e114acc23136",
      "statement": "Identities are persisted across two tables: users holds the primary OAuth identity with provider enum 'github' | 'vercel' and a unique (provider, externalId) index, while accounts holds only linked additional identities with provider enum hard-coded to 'github' and a unique (userId, provider) index enforcing one GitHub link per internal user; this enforces the rule that Vercel can only be primary and GitHub can be both.",
      "evidence": [
        {
          "resource": "repo://lib/db/schema.ts#L14-L39",
          "version": "repo-lines-v1:sha256:1994b3a4db855145972fa6ec9a9d549d79301e3eb7efae384bf4c1b70a3f36bc:"
        },
        {
          "resource": "repo://lib/db/schema.ts#L258-L283",
          "version": "repo-lines-v1:sha256:3560e0b5be165dddea7997114b6db0cf6ac0fc9714a87d5c7ebd17d960c2c6c7:"
        }
