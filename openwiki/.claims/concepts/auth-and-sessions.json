    {
      "id": "claim_269b0c18b2414b09b1aacee78722d7af",
      "statement": "upsertUser in lib/db/users.ts performs a three-stage deduplication in order: (1) if a users row matches (provider, externalId) update its tokens, profile, updatedAt, and lastLoginAt and return its id; (2) if the provider is github and the same GitHub numeric ID is already present in accounts.externalUserId belonging to some user X, return X.id and bump only X.updatedAt and X.lastLoginAt without overwriting X's primary users row; (3) otherwise generate a new nanoid and insert a fresh users row carrying the encrypted tokens and profile fields.",
      "evidence": [
        {
          "resource": "repo://lib/db/users.ts#L15-L90",
          "version": "repo-lines-v1:sha256:b0912c5e6093d5cefa799a5aa4fed375e7034af498048da28a89b5542ccb9ed3:"
        }
      ]
    },
    {
      "id": "claim_d9684fc11a044ba9b8767790190627c8",
      "statement": "The single session cookie _user_session_ is a JWE produced by lib/jwe/encrypt.ts using jose's EncryptJWT with alg='dir', enc='A256GCM' and an expiration of '1y'; the symmetric key comes from process.env.JWE_SECRET base64url-decoded. lib/jwe/decrypt.ts reverses the operation with jwtDecrypt, strips the iat and exp claims, and returns undefined rather than throwing on any failure so a corrupt or expired cookie is treated as anonymous.",
      "evidence": [
        {
          "resource": "repo://lib/jwe/decrypt.ts#L3-L23",
          "version": "repo-lines-v1:sha256:aa37e23d70146804909eb276e9862a9b491526a4629de4f4fb62b40ee82eec9a:"
        },
        {
