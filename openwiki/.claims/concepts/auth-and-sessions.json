    {
      "id": "claim_ed3bbfc8cbc44b7cb8cf5bfedf662806",
      "statement": "The session cookie has exactly two read paths that converge on getSessionFromCookie in lib/session/server.ts: getServerSession in lib/session/get-server-session.ts wraps next/headers cookies() and is wrapped in React's cache() for use in React Server Components, while getSessionFromReq reads from NextRequest.cookies for use inside app/api/** route handlers.",
      "evidence": [
        {
          "resource": "repo://lib/session/get-server-session.ts#L6-L10",
          "version": "repo-lines-v1:sha256:ecd70b3f7bc2df8d10feddb730db9c0398e05f9c6f83006e19c6adff2003dbc8:"
