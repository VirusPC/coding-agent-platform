    {
      "id": "claim_ca4fb627693c4795b9e4581a7d8d7724",
      "statement": "The dev server is launched in `detached: true` mode with two `Writable` streams that split each chunk on `\\n`, prefix `[SERVER]`, and forward each non-empty line to `TaskLogger.info`, giving the UI a live view of the dev server's output.",
