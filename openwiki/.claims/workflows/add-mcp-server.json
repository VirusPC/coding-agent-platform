          "version": "repo-lines-v1:sha256:c9e0a12572e4015f710c27ffc95077849da495deb315083c39ac16cc9719a69c:"
        }
      ]
    },
    {
      "id": "claim_06e47abd112c4abc9194bdd2c9a2c977",
      "statement": "The ConnectorDialog's form submit closure explicitly copies the selected preset's command (local) or url (remote) back into the FormData before invoking the server action, so a preset's transport cannot be silently overridden when the corresponding input is disabled while the preset is selected.",
