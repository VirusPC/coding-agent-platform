    {
      "id": "claim_79d5d0619305424d982f607072b2bc88",
      "statement": "POST /api/tasks/:taskId/sync-changes is the in-editor companion to the PR workflow. It reconnects to the sandbox (with the same getSandbox(taskId) ?? Sandbox.get(...) pattern, and a 410 'Sandbox is not running' mapping) and runs four git commands in cwd: PROJECT_DIR: git add ., git status --porcelain (short-circuits with committed=false if empty), git commit -m <message || 'Sync local changes'>, and git push origin <branchName>. It never touches prStatus or completedAt — pushing new commits is orthogonal to the PR's open/closed/merged state.",
      "evidence": [
        {
          "resource": "repo://app/api/tasks/%5BtaskId%5D/sync-changes/route.ts#L138-L147",
          "version": "repo-lines-v1:sha256:f1b6bfa0f439c442af213389a6cb4d296f9b5d22f9947f6c95d9ca0855b19bc2:"
