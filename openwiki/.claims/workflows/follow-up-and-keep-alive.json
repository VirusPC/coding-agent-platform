    {
      "id": "claim_65755921ff2e47648970db4390a1e08e",
      "statement": "POST /api/tasks/:taskId/continue is a thin shell that authenticates, runs checkRateLimit, validates the message, loads the task with the standard userId + isNull(deletedAt) filter, rejects with 400 if branchName is null, persists a taskMessages row with role='user', rewinds the row to status='processing', progress=0, completedAt=NULL, snapshots userApiKeys + getUserGitHubToken + getGitHubUser + getMaxSandboxDuration, schedules continueTask inside after(), and returns 200 { success: true } before any sandbox or agent work runs.",
      "evidence": [
        {
          "resource": "repo://app/api/tasks/%5BtaskId%5D/continue/route.ts#L22-L116",
          "version": "repo-lines-v1:sha256:8f0145d8422de3bee08e427072be1fb43cfeaf82743829f59b78dccad8bca5c8:"
        },
