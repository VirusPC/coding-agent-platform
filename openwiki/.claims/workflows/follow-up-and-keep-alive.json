    {
      "id": "claim_3fd81ae303244d1db9d7837579b718f0",
      "statement": "continueTask attempts to reconnect to the existing VM via Sandbox.get(sandboxId) only when task.sandboxId and task.keepAlive are both set; on a Sandbox.get failure or when keepAlive is false, it falls through to createSandbox(...) with preDeterminedBranchName: branchName so the follow-up commit lands on the same branch as the original. The in-memory Map<taskId, Sandbox> is not consulted — the continue handler runs in a different serverless execution than the worker that registered the sandbox, so the durable tasks.sandboxId column plus Sandbox.get is the only path.",
      "evidence": [
        {
          "resource": "repo://app/api/tasks/%5BtaskId%5D/continue/route.ts#L162-L243",
          "version": "repo-lines-v1:sha256:1696e2751495ee431c2d6f06a14b18154fe4c9042f90fdbb82f65fdd460756c1:"
