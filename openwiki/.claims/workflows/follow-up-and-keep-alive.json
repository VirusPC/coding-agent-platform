    {
      "id": "claim_69c4a7d2b7934d769fcf5c4fde0e5282",
      "statement": "Every follow-up message counts against the daily rate limit: the continue handler calls checkRateLimit(session.user.id) at the top and the combined tasksToday + userMessagesToday counter joins tasks to taskMessages on role='user' createdAt >= startOfTodayUtc() with isNull(tasks.deletedAt). A 429 response carries the combined total, remaining, and the next UTC midnight as resetAt.",
      "evidence": [
        {
          "resource": "repo://app/api/tasks/%5BtaskId%5D/continue/route.ts#L30-L42",
