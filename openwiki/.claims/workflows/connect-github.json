    {
      "id": "claim_049be0ecc3b445e39e2f28066a46248f",
      "statement": "components/repo-selector.tsx self-heals a stale GitHub link by POSTing to /api/auth/github/disconnect and setting githubConnectionAtom.connected = false whenever /api/github/user or /api/github/orgs returns 401/403.",
