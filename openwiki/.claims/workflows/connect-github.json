          "version": "repo-lines-v1:sha256:8436e24213ed65045411e79770b69a8b65104ba045e7760b83bb7113622e96a6:"
        }
      ]
    },
    {
      "id": "claim_bb870482dd064e52a52e806a0b15cf07",
      "statement": "The user-visible Connect GitHub buttons navigate to the legacy GET /api/auth/github/signin entrypoint from two places: the avatar dropdown in components/auth/sign-out.tsx (only when authProvider === 'vercel' and GitHub is enabled), and the empty repo selector in components/home-page-content.tsx (handleConnectGitHub and handleReconfigureGitHub).",
