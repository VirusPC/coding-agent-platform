    {
      "id": "claim_3371adc7ce204e318eaedef4fd032760",
      "statement": "POST /api/tasks schedules three next/server after() callbacks before returning 200 { task: newTask }: the two AI-enrichment callbacks (generateBranchName via lib/utils/branch-name-generator.ts and generateTaskTitle via lib/utils/title-generator.ts, each writing its column back via UPDATE) and the worker callback that drives processTaskWithTimeout; the third after() is the only one that runs the actual sandbox/agent/push pipeline.",
      "evidence": [
        {
          "resource": "repo://app/api/tasks/route.ts#L94-L243",
          "version": "repo-lines-v1:sha256:bb3c3cd7c2e5e18677441d92788a1218254c06a32aca2ec9fae9304ede4e29d9:"
        }
      ]
    },
    {
      "id": "claim_430511cacd0e4d209735f36c263d21f3",
      "statement": "Because next/server after() runs after the request scope is gone, all session-bound reads — getUserApiKeys, getUserGitHubToken, getGitHubUser, and getMaxSandboxDuration — must be resolved synchronously above the after() block; processTaskWithTimeout then receives the resolved values as arguments.",
      "evidence": [
