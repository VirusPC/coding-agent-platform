    {
      "id": "claim_cab34e24acba4821889f9ec38ff8a9d0",
      "statement": "processTaskWithTimeout enforces the task-level deadline with a Promise.race between processTask and a setTimeout(maxDuration minutes) reject; it also schedules a one-minute-before-deadline warning log that is cleared in both the success and failure branches.",
      "evidence": [
