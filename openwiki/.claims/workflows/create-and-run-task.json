    {
      "id": "claim_b84e41af30814e939f69fc151c9efa3b",
      "statement": "processTask runs in this order: updateStatus('processing') with progress=10; insert the user's prompt into taskMessages (role='user'); first isTaskStopped checkpoint; waitForBranchName with a 10-second ceiling (so the AI branch from after() #1 has a chance to land); second isTaskStopped checkpoint; createSandbox with a preDeterminedBranchName so the AI branch is honored if ready; UPDATE the row with sandboxId + sandboxUrl (and branchName only if no AI branch existed); third isTaskStopped checkpoint; load and decrypt connected MCP connectors; sanitize the prompt for CLI safety; executeAgentInSandbox with taskId and a generated agentMessageId for streaming updates; persist agentSessionId and the agent's response message; generate an AI commit message (or fallback); pushChangesToBranch; branch on keepAlive.",
      "evidence": [
        {
          "resource": "repo://app/api/tasks/route.ts#L366-L736",
          "version": "repo-lines-v1:sha256:4bdbac6a8b957420258e96d169ede463c011385fd529e7208e5cc1a8334b236d:"
        }
