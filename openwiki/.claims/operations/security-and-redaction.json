    {
      "id": "claim_d5d17965003542d28d9f2762068406f7",
      "statement": "redactSensitiveInfo in lib/utils/logging.ts is a backup defense only; AGENTS.md explicitly says the primary defense is the static-string rule. The function runs a closed allowlist of regex patterns, so any secret that is not in the pattern set reaches the UI verbatim (POSTGRES_URL is the canonical gap).",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L42-L52",
          "version": "repo-lines-v1:sha256:f541e8722c1b0d36458a04e81f7cdf0e93854bd8f680c634a1cabe2173e11102:"
