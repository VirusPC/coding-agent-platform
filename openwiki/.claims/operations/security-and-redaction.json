    {
      "id": "claim_1beb7aa84d834e93b55acd74f2683f9a",
      "statement": "All log statements in user-facing code paths must be static strings - no template literals with `${}` interpolation - across logger.info/error/success/command and console.log/error/warn. This is the project's primary defense against leaking sensitive values into the UI, because the tasks.logs jsonb column is streamed directly to the browser.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L7-L33",
          "version": "repo-lines-v1:sha256:8f3e8d25976bb99f385f635d4171c5fca1ecd93d900cdd2955c849885abfe2f9:"
